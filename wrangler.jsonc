{
  "name": "fake-news-detector",
  "main": "app/server/src/index.ts",
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
    },
  },
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
  ],
  // Daily reconciliation sweep of orphaned storage uploads (03:00 UTC). Runs the
  // `scheduled` handler in app/server/src/index.ts.
  "triggers": {
    "crons": ["0 3 * * *"],
  },
}
