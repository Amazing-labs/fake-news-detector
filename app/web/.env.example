# Supabase Environment Variables
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_STORAGE_BUCKET="fake-news-media"

# Better Auth / API
# Keep Better Auth enabled by default in dev. Set VITE_BETTER_AUTH_DISABLE=true only for frontend-only bypass work.
VITE_BETTER_AUTH_DISABLE=false
VITE_BETTER_AUTH_ALLOW_PRODUCTION_BYPASS=false

# The app always calls the API on its own origin (`/api/...`). What forwards
# that to the Hono worker differs per environment, and NEITHER is a build-time
# variable — setting VITE_* alone will not make production reach the backend:
#   - dev:  vite.config.ts `server.proxy` (this variable). Dev server only:
#           `vite build` ignores it completely.
#   - prod: the `/api/:path*` rewrite in vercel.json.
VITE_SERVER_PROXY_TARGET="http://localhost:3000"

# Must stay a same-origin path in every environment, so the auth cookie stays
# first-party. Pointing this at the worker's absolute URL makes the session
# cookie third-party (vercel.app and workers.dev are both public suffixes),
# which Safari and Firefox drop by default.
VITE_AUTH_BASE_URL="/api/auth"

# supabase uploads environment variables
VITE_SUPABASE_URL="https://xxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="change-me-to-your-anon-key"
VITE_SUPABASE_STORAGE_BUCKET="fake-news-media"
