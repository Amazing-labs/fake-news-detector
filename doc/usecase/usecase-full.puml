@startuml usecase-full
' =============================================================================
' Fake News Detector — Diagramme de cas d'utilisation (vue complète)
' Source de vérité : doc/api.md (toutes les routes HTTP) croisé avec la matrice
' de permissions de SecurityService.
'
' Structure : acteurs à gauche, tous spécialisant « Utilisateur » ; un seul
' rectangle système ; « S'authentifier » inclus par tous les cas.
' Les cas sont regroupés par rôle à l'intérieur du rectangle : en colonne unique,
' 38 cas d'utilisation produisent une image de 2389x4410 illisible.
' =============================================================================

left to right direction
skinparam shadowless true
skinparam defaultFontName "Arial"
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #4A5568
}

title Fake News Detector — Cas d'utilisation (vue complète)\nToutes les fonctionnalités exposées par l'API

' ==========================================
' ACTEURS
' ==========================================

actor "Citoyen Vigie" as V
actor "Citoyen" as C
actor "Journaliste" as J
actor "Directeur\nPublication" as D
actor "Utilisateur" as U

V --|> C
C --|> U
J --|> U
D --|> U

rectangle "Application de Fact-Checking" {

  package "Socle commun" {
    usecase "Consulter son profil" as UC01
    usecase "Consulter ses contributions" as UC02
    usecase "Consulter ses indicateurs" as UC03
    usecase "Consulter et marquer\nses notifications" as UC04
    usecase "Consulter les signalements" as UC05
    usecase "Consulter les enquêtes" as UC06
    usecase "Consulter les publications" as UC07
    usecase "Consulter les rectifications" as UC08
    usecase "Nettoyer les fichiers\nd'un envoi abandonné" as UC09
  }

  package "Citoyen" {
    usecase "Déposer un signalement" as UC10
    usecase "Postuler comme vigie" as UC11
  }

  package "Citoyen Vigie" {
    usecase "Apporter une preuve\nà une enquête" as UC12
  }

  package "Journaliste" {
    usecase "Consulter la boîte\nde réception éditoriale" as UC20
    usecase "Consulter les signalements\nouverts" as UC21
    usecase "Prendre en charge un sujet" as UC22
    usecase "Rédiger le brouillon\nd'enquête" as UC23
    usecase "Corriger l'enquête\naprès révision" as UC24
    usecase "Classer un média source" as UC25
    usecase "Classer un média\nde preuve vigie" as UC26
    usecase "Ajouter une preuve\njournalistique" as UC27
    usecase "Soumettre l'enquête\nà validation" as UC28
  }

  package "Directeur Publication" {
    usecase "Créer un sujet éditorial" as UC30
    usecase "Supprimer un sujet éditorial" as UC31
    usecase "Approuver et publier\nune enquête" as UC32
    usecase "Renvoyer une enquête\nen révision" as UC33
    usecase "Archiver une enquête\ninvérifiable" as UC34
    usecase "Annuler une enquête" as UC35
    usecase "Publier une rectification" as UC36
    usecase "Consulter les candidatures\nvigie" as UC37
    usecase "Approuver une candidature\nvigie" as UC38
    usecase "Rejeter une candidature\nvigie" as UC39
    usecase "Créer un compte journaliste" as UC40
    usecase "Bannir, désactiver ou\nréactiver un journaliste" as UC41
    usecase "Bannir, désactiver ou\nréactiver un citoyen" as UC42
    usecase "Consulter le tableau\nde bord directeur" as UC43
    usecase "Consulter l'historique\nde ses décisions" as UC44
    usecase "Purger les médias orphelins" as UC45
  }

  package "Authentification" {
    usecase "S'authentifier" as AUTH
  }
}

